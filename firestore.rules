rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tanimmkd@gmail.com' ||
        request.auth.token.email == 'j_tanim@hotmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validation helpers
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.role in ['designer', 'employer', 'admin'] &&
             (!('headline' in data) || (data.headline is string && data.headline.size() <= 150)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('hourlyRate' in data) || (data.hourlyRate is string && data.hourlyRate.size() <= 50)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000));
    }

    function isValidJobListing(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.company is string && data.company.size() <= 100 &&
             data.category is string && data.category.size() <= 50 &&
             data.type in ['Full-time', 'Part-time', 'Contract', 'Freelance', 'Internship'] &&
             data.location is string && data.location.size() <= 100 &&
             data.salary is string && data.salary.size() <= 100 &&
             data.employerId is string && data.employerId.size() <= 128 &&
             data.contactEmail is string && data.contactEmail.size() <= 150 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000));
    }

    function isValidJobApplication(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.jobId is string && data.jobId.size() <= 128 &&
             data.applicantId is string && data.applicantId.size() <= 128 &&
             data.applicantEmail is string && data.applicantEmail.size() <= 150 &&
             data.coverLetter is string && data.coverLetter.size() <= 5000;
    }

    function isValidJobSubscription(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.subscribedAt is string && data.subscribedAt.size() <= 50;
    }

    function isValidContactMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.message is string && data.message.size() <= 4000 &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true; // Public designer directory & employer badges
      allow create: if (isOwner(userId) || isSignedIn()) && isValidUserProfile(incoming()) && isValidId(userId);
      allow update: if (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming()) && isValidId(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Job Listings (Open public read for job seekers, verified creation/management)
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isValidJobListing(incoming()) && isValidId(jobId);
      allow update: if (
        (isSignedIn() && (resource.data.employerId == request.auth.uid || isAdmin())) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['applicantCount'])
      ) && isValidJobListing(incoming()) && isValidId(jobId);
      allow delete: if isSignedIn() && (resource.data.employerId == request.auth.uid || isAdmin());
    }

    // Job Applications
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.applicantEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isValidJobApplication(incoming()) && isValidId(applicationId);
      allow update: if isSignedIn() && (resource.data.applicantId == request.auth.uid || isAdmin()) && isValidJobApplication(incoming());
      allow delete: if isSignedIn() && (resource.data.applicantId == request.auth.uid || isAdmin());
    }

    // Email Subscriptions
    match /subscriptions/{subscriptionId} {
      allow create: if isValidJobSubscription(incoming()) && isValidId(subscriptionId);
      allow read, update, delete: if isAdmin();
    }

    // Contact Messages
    match /contact_messages/{messageId} {
      allow create: if isValidContactMessage(incoming()) && isValidId(messageId);
      allow read, update, delete: if isAdmin();
    }
  }
}
